{
  "name": "playwrightfinalframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf playwright-report allure-results blob-report test-results storage-states",

    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",

    "ui:prod": "cross-env NODE_ENV=PROD playwright test --project=ui-chromium",
    "ui:dev": "cross-env NODE_ENV=DEV playwright test --project=ui-chromium",

    "api:prod": "cross-env NODE_ENV=PROD playwright test --project=api",
    "api:dev": "cross-env NODE_ENV=DEV playwright test --project=api",

    "test:prod": "cross-env NODE_ENV=PROD playwright test --project=ui-chromium --project=api --project=visual-chromium",
    "test:dev": "cross-env NODE_ENV=DEV playwright test --project=ui-chromium --project=api --project=visual-chromium",

    "test:ci": "cross-env CI=true NODE_ENV=PROD playwright test --project=ui-chromium --project=api --project=visual-chromium",

    "test:visual": "cross-env NODE_ENV=PROD playwright test --project=visual-chromium",
    "test:visual:update": "cross-env NODE_ENV=PROD playwright test --project=visual-chromium --update-snapshots",

    "gen-key": "tsx src/shared/utilities/crypto/generate-key.utility.ts",
    "encrypt-secret": "tsx src/shared/utilities/crypto/encrypt-secret.utility.ts",

    "allure": "npx allure serve allure-results",

    "docker:build": "docker build --build-arg PLAYWRIGHT_VERSION=1.61.1 -t playwright-final-framework:local ."
  
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.2",
    "allure": "^3.14.3",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.7.0",
    "eslint-plugin-playwright": "^2.10.5",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  }
}
